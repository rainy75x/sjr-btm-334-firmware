-DENABLE_GAIA_PERSISTENT_USER_EQ_BANK
-DENABLE_GAIA_RFCOMM
-DGATT_ENABLED
-DGATT_ANCS_CLIENT
-DGATT_IAS_SERVER
-DHI_RES_AUDIO
-DENABLE_PBAP
-DENABLE_USB
-DENABLE_USB_AUDIO
-DENABLE_USB_HID_UPGRADE
-DENABLE_WATCHDOG
-DENABLE_WIRED
-DGATT_GAIA_SERVER
-DINCLUDE_A2DP_EXTRA_CODECS
-DINCLUDE_APTX_ACL_SPRINT
-DINCLUDE_APTX_ADAPTIVE
-DINCLUDE_DSP
-DENABLE_USB_AUDIO_APP_STEREO_DESCRIPTORS
